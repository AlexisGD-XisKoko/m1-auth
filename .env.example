# Copia este archivo como .env y rellena los valores. NUNCA subas .env a Git.
APP_VERSION=0.1.0

# Conexión con el rol de la app (m1_app), no con el dueño del esquema
DATABASE_URL=postgresql+psycopg://m1_app:change-me@db:5432/boletera
REDIS_URL=redis://redis:6379/0

JWT_ISSUER=https://auth.boletera.local
JWT_AUDIENCE=boletera

# Llave de cifrado de llaves (KEK), 32 bytes en base64. La genera Johan.
KEK_BASE64=
