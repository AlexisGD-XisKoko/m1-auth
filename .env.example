# Copia este archivo como .env y agrega los secretos:
#   cp .env.example .env && python scripts/gen_secrets.py >> .env
# NUNCA subas .env a Git.

ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Fuera de Docker (uvicorn local) apunta a localhost; docker-compose la sobrescribe.
DATABASE_URL=postgresql+psycopg://m1_app:CAMBIAR@localhost:5432/boletera
MIGRATIONS_DATABASE_URL=postgresql+psycopg://m1_owner:CAMBIAR@localhost:5432/boletera
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=redis

JWT_ISSUER=https://auth.boletera.local
JWT_AUDIENCE=boletera-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Primer administrador (se crea al arrancar si no existe ningún admin).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# PKI: en desarrollo se simula la ceremonia si no hay intermedias cargadas.
# En integración/producción: false y cargar con scripts/ceremony/ceremony.py m1-load
PKI_DEV_BOOTSTRAP=true
PKI_PROFILE_POLICY=event-signing=m4-tickets;service=*
TRUST_PROXY_CLIENT_CERT=false

# TTP (sellado de tiempo RFC 3161). Vacío = sin sellos (deseable).
TSA_URL=

ENABLE_DEV_STUB=true

# --- Secretos: los agrega scripts/gen_secrets.py --------------------------------------
# KEK_BASE64, PEPPER_BASE64, EVENTS_HMAC_KEY_BASE64,
# M1_OWNER_PASSWORD, M1_APP_PASSWORD, OTHER_MODULES_PASSWORD, BOOTSTRAP_ADMIN_PASSWORD
